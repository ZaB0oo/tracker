{
  "name": "osu-completionist-tracker",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "npm --workspace web run dev",
    "build": "tsc -p tsconfig.json && node -e \"const f=require('fs');f.copyFileSync('server/db/schema.sql','dist/server/db/schema.sql');f.copyFileSync('server/db/seed-sets.json','dist/server/db/seed-sets.json')\" && npm --workspace web run build",
    "start": "node dist/server/index.js",
    "desktop": "npm run build && electron desktop/main.js",
    "desktop:check": "electron desktop/check-runtime.js",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "export-seed": "node scripts/export-seed-sets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --workspace web exec tsc -- --noEmit",
    "check": "npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "build": {
    "appId": "com.zaboo.osucompletionist",
    "productName": "osu!completionist",
    "asar": false,
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "web/dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "osu-completionist-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "desktop/icon.png",
      "artifactName": "osu-completionist-${version}-mac.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "desktop/icon.png",
      "executableName": "osu-completionist",
      "artifactName": "osu-completionist-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "ZaB0oo",
      "repo": "tracker"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "tar-stream": "^3.1.7",
    "unbzip2-stream": "^1.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/tar-stream": "^3.1.3"
  }
}
